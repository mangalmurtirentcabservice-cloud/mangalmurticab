# Supabase (required for admin, routes, tourism, reviews, enquiries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical production URL (used by sitemap.xml + robots.txt)
NEXT_PUBLIC_SITE_URL=https://mangalmurticab.com

# Optional: replace hero video with an external URL (defaults to /hero-bg.mp4 in the repo)
# NEXT_PUBLIC_HERO_VIDEO_URL=https://your-project.supabase.co/storage/v1/object/public/media/hero-bg.mp4

# Enquiry mail goes to the site email. No extra email service key is required.

ADMIN_SESSION_SECRET=generate-a-long-random-secret-here

# Admin login (email + password, checked only on the server)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
